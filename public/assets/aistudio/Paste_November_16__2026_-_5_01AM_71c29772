                    fbTitle.className = 'font-extrabold text-sm text-emerald-300';
                    fbTitle.textContent = `🎉 Jawaban Benar! Maju +${q.steps || 3} Langkah!`;
                } else {
                    playSoundEffect('wrong');
                    fbEl.className = 'p-4 rounded-2xl border bg-rose-500/15 border-rose-400/40 text-xs sm:text-sm space-y-1.5';
                    fbTitle.className = 'font-extrabold text-sm text-rose-300';
                    fbTitle.textContent = '❌ Kurang Tepat! Bidak bertahan di tempat.';
                }
                fbExp.textContent = q.explanation || 'Terus berlatih untuk meningkatkan pemahamanmu!';
            }
            contWrap?.classList.remove('hidden');
        };

        window.dismissQuizModal = function () {
            activeQuizData = null;
