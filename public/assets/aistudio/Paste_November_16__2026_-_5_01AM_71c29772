        window.openNextStudentQuiz = function () {
            const room = getCurrentRoom();
            if (!room || isAnimatingMove) return;
            if (room.phase !== 'playing') {
                showToast('Tunggu Guru memulai atau melanjutkan kelas terlebih dahulu.', 'warning');
