        function showWinnerPodiumModal(room) {
            const listEl = document.getElementById('winner-podium-list');
            const students = Object.values(room.players || {})
                .filter(p => p.role !== 'teacher')
                .sort((a, b) => (b.position - a.position) || (b.score - a.score));

            if (listEl) {
                if (students.length === 0) {
                    listEl.innerHTML = `<div class="p-4 rounded-2xl bg-slate-900 text-xs text-slate-300 text-center">Belum ada siswa di papan peringkat.</div>`;
                } else {
                    const medals = ['🥇', '🥈', '🥉'];
                    listEl.innerHTML = students.slice(0, 5).map((p, idx) => `
                        <div class="p-3 rounded-2xl bg-slate-900/90 border border-slate-800 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <span class="text-lg">${medals[idx] || `#${idx + 1}`}</span>
                                <span class="text-lg">${p.avatar || '🦊'}</span>
                                <div>
                                    <div class="text-xs font-extrabold text-white">${p.name}</div>
                                    <div class="text-[11px] text-slate-400">Petak ${p.position}/100 • ${p.correctCount || 0} Benar</div>
                                </div>
                            </div>
                            <span class="text-xs font-extrabold text-amber-300">${p.score || 0} Poin</span>
                        </div>
                    `).join('');
                }
            }
            playSoundEffect('win');
            document.getElementById('winner-modal')?.classList.remove('hidden');
