        window.joinRoomAsStudent = function (code) {
            const cleanCode = (code || '').trim().toUpperCase();
            const rooms = getLocalRoomsMap();
            const room = rooms[cleanCode];
            if (!room) {
                showToast(`Kelas dengan kode "${cleanCode}" tidak ditemukan.`, 'error');
                return;
            }

            const prof = getActiveUserProfile();
            const studentInput = document.getElementById('input-student-name')?.value.trim();
            if (studentInput) {
                prof.name = studentInput;
                saveUserProfile(prof);
                updateLobbyProfileUI();
            }

            if (!room.players) room.players = {};
            if (!room.players[prof.id]) {
                room.players[prof.id] = {
                    id: prof.id,
                    name: prof.name,
                    avatar: prof.avatar || '🦊',
                    color: prof.color || PAWN_COLORS[Object.keys(room.players).length % PAWN_COLORS.length],
                    role: 'student',
                    position: 1,
                    score: 0,
                    correctCount: 0,
                    answeredCount: 0
                };
                appendChatMessage(room, prof.name, prof.avatar || '🦊', 'bergabung ke dalam kelas!', true);
                appendActivityLog(room, `${prof.avatar} ${prof.name} bergabung ke kelas`);
            } else {
                room.players[prof.id].name = prof.name;
                room.players[prof.id].avatar = prof.avatar || '🦊';
            }

            currentRoomId = cleanCode;
            currentUserRole = 'student';
            consecutiveCorrectCount = 0;
            hasStreakShield = false;

            persistRoomUpdate(room, 'ROOM_UPDATED');
            enterGameArenaHUD();
            showToast(`Berhasil bergabung ke ${room.name}!`, 'success');
        };

