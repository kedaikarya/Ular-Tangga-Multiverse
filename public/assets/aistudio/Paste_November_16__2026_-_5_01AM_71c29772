        window.handleTeacherPinSubmit = function (ev) {
            ev.preventDefault();
            const existingPin = getStoredTeacherPin();
            const oldPin = (document.getElementById('input-teacher-pin-old')?.value || '').trim();
            const newPin = (document.getElementById('input-teacher-pin')?.value || '').trim();
            const confirmPin = (document.getElementById('input-teacher-pin-confirm')?.value || '').trim();
            const errEl = document.getElementById('teacher-pin-error');

            function showPinError(msg) {
                if (errEl) {
                    errEl.textContent = msg;
                    errEl.classList.remove('hidden');
                }
            }

            if (teacherPinModalMode === 'change') {
                if (oldPin !== existingPin) {
                    showPinError('PIN Guru lama tidak sesuai.');
                    return;
                }
                if (newPin.length < 4) {
                    showPinError('PIN baru minimal 4 karakter.');
                    return;
                }
                if (newPin !== confirmPin) {
                    showPinError('Konfirmasi PIN baru tidak cocok.');
                    return;
                }
                try {
                    localStorage.setItem(STORAGE_KEYS.TEACHER_PIN, newPin);
                } catch (_) {}
                if (broadcastChannel) {
                    broadcastChannel.postMessage({ type: 'TEACHER_PIN_UPDATED', pin: newPin });
                }
                closeTeacherPinModal();
                showToast('PIN Rahasia Guru berhasil diperbarui!', 'success');
                return;
            }

            if (newPin !== existingPin) {
                showPinError('PIN Guru salah. Silakan periksa kembali.');
                return;
            }

            try {
                sessionStorage.setItem(STORAGE_KEYS.TEACHER_SESSION, 'unlocked');
            } catch (_) {}
            updateTeacherAuthUI();
            closeTeacherPinModal();

            if (teacherPinModalMode === 'delete_room' && pendingDeleteRoomCode) {
                executeDeleteRoom(pendingDeleteRoomCode);
                pendingDeleteRoomCode = null;
            } else {
                document.getElementById('create-class-setup-modal')?.classList.remove('hidden');
            }
        };

