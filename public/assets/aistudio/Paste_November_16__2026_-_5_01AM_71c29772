<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Ular Tangga Edukasi 3D — Layar Guru & Siswa Real-Time</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
    <!-- Three.js & OrbitControls -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <!-- Tone.js untuk efek suara sintetis tanpa URL eksternal -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }
        html, body {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100dvh;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            background-color: #060913;
            color: #f8fafc;
            user-select: none;
        }
        .font-display {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }
        #canvas-container {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100dvh;
            z-index: 1;
            touch-action: none;
        }
        #canvas-container canvas {
            display: block;
            width: 100% !important;
            height: 100% !important;
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(148, 163, 184, 0.18);
        }
        .glass-panel-strong {
            background: rgba(9, 14, 28, 0.92);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            border: 1px solid rgba(148, 163, 184, 0.22);
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.4);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.45);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.75);
        }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.55); }
            50% { box-shadow: 0 0 0 10px rgba(99, 102, 241, 0); }
        }
        .btn-pulse {
            animation: pulseGlow 2.2s infinite;
        }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-4px); }
        }
        .animate-float {
            animation: floatSlow 3s ease-in-out infinite;
        }
    </style>
</head>
<body>
    <!-- Kanvas WebGL 3D Fullscreen -->
    <div id="canvas-container"></div>

    <!-- Wadah Toast Notifikasi -->
    <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-[120] flex flex-col items-center gap-2 pointer-events-none w-[92vw] max-w-md"></div>

    <!-- =====================================================================
         1. LAYAR LOBI UTAMA (ALUR GURU & ALUR PEMAIN / SISWA)
         ===================================================================== -->
    <div id="lobby-overlay" class="fixed inset-0 z-30 flex flex-col justify-between p-3 sm:p-5 overflow-y-auto bg-gradient-to-b from-slate-950/65 via-slate-950/45 to-slate-950/85">
        <!-- Bilah Atas Lobi -->
        <header class="w-full max-w-6xl mx-auto glass-panel rounded-2xl px-4 py-3 flex flex-wrap items-center justify-between gap-3 shadow-2xl">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-500 to-amber-500 flex items-center justify-center text-2xl shadow-lg">
                    🎲
                </div>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1 class="font-display text-base sm:text-lg font-extrabold tracking-tight text-white">
                            Ular Tangga Edukasi 3D
                        </h1>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
                            FASE A – D • ∞ SOAL
                        </span>
                    </div>
                    <p class="text-[11px] sm:text-xs text-slate-300">
                        Papan Balok Bertingkat 3D • Layar Guru & Siswa Real-Time
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-2 flex-wrap">
                <button onclick="openFlowGuideModal()" class="px-3 py-2 rounded-xl bg-sky-500/20 hover:bg-sky-500/30 border border-sky-400/40 text-sky-200 text-xs font-extrabold transition flex items-center gap-1.5">
                    🗺️ <span>Alur</span>
                </button>
                <button onclick="openOverlayModal('leaderboard')" class="px-3 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 text-amber-200 text-xs font-extrabold transition flex items-center gap-1.5">
                    🏆 <span>Peringkat</span>
                </button>
                <button onclick="openOverlayModal('analytics')" class="px-3 py-2 rounded-xl bg-indigo-500/20 hover:bg-indigo-500/30 border border-indigo-400/40 text-indigo-200 text-xs font-extrabold transition flex items-center gap-1.5">
                    📊 <span>Analitik</span>
                </button>
                <button onclick="openOverlayModal('profile')" class="px-3 py-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-bold transition flex items-center gap-1.5">
                    <span id="lobby-profile-avatar">🦊</span>
                    <span id="lobby-profile-name" class="max-w-[90px] truncate">Siswa</span>
                </button>
                <button id="lobby-music-btn" onclick="toggleMusic()" class="px-3 py-2 rounded-xl bg-pink-500/20 hover:bg-pink-500/30 border border-pink-400/40 text-pink-200 text-xs font-extrabold transition flex items-center gap-1" title="Nyalakan / Matikan Musik Latar">
                    🎵 <span>Musik</span>
                </button>
                <button id="lobby-music-style-btn" onclick="cycleMusicStyle()" class="px-2.5 py-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-bold transition" title="Ganti Gaya Musik Latar">
                    🎶 Ceria
                </button>
                <button onclick="toggleNativeFullscreen()" class="p-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-bold transition" title="Layar Penuh">
                    ⛶
                </button>
            </div>
        </header>

        <!-- Konten Tengah Lobi -->
        <main class="w-full max-w-6xl mx-auto my-auto py-4 grid grid-cols-1 lg:grid-cols-12 gap-4">
            <!-- Kolom Kiri: Portal Guru & Portal Siswa -->
            <div class="lg:col-span-7 flex flex-col gap-4">
                <!-- Kartu 1: Akses Layar Guru -->
                <section class="glass-panel-strong rounded-3xl p-5 border border-amber-400/30 shadow-2xl relative overflow-hidden">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="space-y-1">
                            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/20 border border-amber-400/40 text-amber-200 text-[11px] font-extrabold">
                                👩‍🏫 KHUSUS GURU / PENGAJAR
                            </div>
                            <h2 class="font-display text-lg sm:text-xl font-extrabold text-white">
                                Buat Kelas & Layar Monitor Guru
                            </h2>
                            <p class="text-xs text-slate-300 leading-relaxed max-w-xl">
                                Pilih <strong>Fase A–D (SD–SMP)</strong>, <strong>Mata Pelajaran</strong>, <strong>Materi</strong>, kelola soal dengan <strong>Generator AI</strong>, atur tema papan (<em>Kayu</em> / <em>Grayscale</em> / <em>Pelangi</em>) & warna ular, serta pantau pergerakan siswa secara real-time.
                            </p>
                        </div>

                        <div class="flex items-center gap-2">
                            <span id="teacher-auth-badge" class="hidden px-2.5 py-1 rounded-xl bg-emerald-500/20 border border-emerald-400/40 text-emerald-200 text-[11px] font-extrabold">
                                🔓 Sesi Guru Aktif
                            </span>
                            <button id="btn-lock-teacher" onclick="lockTeacherSession()" class="hidden px-2.5 py-1 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 border border-rose-400/40 text-rose-200 text-[11px] font-extrabold transition">
                                🔒 Kunci
                            </button>
                        </div>
                    </div>

                    <div class="mt-4 flex flex-wrap items-center gap-3">
                        <button onclick="openTeacherCreateFlow()" class="flex-1 min-w-[220px] py-3.5 px-5 rounded-2xl bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 hover:from-amber-400 hover:to-rose-400 text-slate-950 font-extrabold text-sm shadow-xl shadow-orange-500/20 transition transform active:scale-[0.99] flex items-center justify-center gap-2">
                            <span>👩‍🏫 Buat Kelas (Layar Guru)</span>
                        </button>
                    </div>
                </section>

                <!-- Kartu 2: Portal Masuk Pemain / Siswa -->
                <section class="glass-panel-strong rounded-3xl p-5 border border-indigo-400/30 shadow-2xl">
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <div>
                            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/40 text-indigo-200 text-[11px] font-extrabold mb-1">
                                🎒 PORTAL PEMAIN / SISWA
                            </div>
                            <h2 class="font-display text-lg font-extrabold text-white">
                                Gabung ke Kelas Pembelajaran
                            </h2>
                        </div>
                        <span class="text-[11px] font-bold text-slate-400">Kapasitas ∞ Siswa</span>
                    </div>

                    <form onsubmit="handleStudentFlowJoin(event)" class="grid grid-cols-1 sm:grid-cols-12 gap-3">
                        <div class="sm:col-span-6">
                            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Nama Siswa</label>
                            <input id="input-student-name" type="text" maxlength="24" required placeholder="Ketik nama kamu..." class="w-full px-4 py-3 rounded-2xl bg-slate-950/90 border border-slate-700 focus:border-indigo-400 outline-none text-sm font-bold text-white placeholder:text-slate-500">
                        </div>
                        <div class="sm:col-span-3">
                            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Kode Kelas</label>
                            <input id="input-join-code" type="text" maxlength="6" required placeholder="ABCDEF" class="w-full px-3 py-3 rounded-2xl bg-slate-950/90 border border-slate-700 focus:border-indigo-400 outline-none text-center font-mono text-base font-extrabold uppercase tracking-widest text-amber-300 placeholder:text-slate-600">
                        </div>
                        <div class="sm:col-span-3 flex items-end">
                            <button type="submit" class="w-full py-3 px-4 rounded-2xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-extrabold text-sm shadow-lg shadow-indigo-500/25 transition active:scale-[0.98]">
                                🚀 Masuk
                            </button>
                        </div>
                        <div class="sm:col-span-12 pt-1">
                            <div class="flex items-center justify-between mb-1.5">
                                <label class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Pilih Karakter Bidak 3D</label>
                                <span id="lobby-selected-char-label" class="text-[11px] font-extrabold text-indigo-300">🦊 Rubah</span>
                            </div>
                            <div id="lobby-avatar-picker" class="grid grid-cols-6 sm:grid-cols-12 gap-1.5"></div>
                        </div>
                    </form>
                </section>
            </div>

            <!-- Kolom Kanan: Daftar Kelas Aktif Real-Time + Hapus oleh Guru -->
            <div class="lg:col-span-5 glass-panel-strong rounded-3xl p-5 border border-slate-700/70 shadow-2xl flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <div>
                            <h3 class="font-display text-base font-extrabold text-white flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                                Kelas Aktif Real-Time
                            </h3>
                            <p class="text-[11px] text-slate-400">Klik kelas untuk langsung bergabung, atau hapus riwayat (khusus Guru).</p>
                        </div>
                        <span id="open-rooms-count" class="px-2.5 py-1 rounded-xl bg-slate-800 text-slate-300 text-xs font-extrabold">0 Kelas</span>
                    </div>

                    <div id="open-rooms-list" class="space-y-2.5 max-h-[300px] overflow-y-auto pr-1"></div>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400">
                    <span id="lobby-profile-stats">Skor: 0 • Akurasi: 0%</span>
                    <span>Putar kamera 3D dengan geser layar</span>
                </div>
            </div>
        </main>

        <!-- Footer Ringkas -->
        <footer class="w-full max-w-6xl mx-auto text-center text-[11px] text-slate-400">
            Jawab soal Fase A–D (SD–SMP) tanpa batas (∞) untuk melompati balok bertingkat 3D menuju Petak 100!
        </footer>
    </div>

    <!-- =====================================================================
         2. HUD ARENA 3D (TERPISAH ANTARA LAYAR GURU & LAYAR PEMAIN)
         ===================================================================== -->
    <div id="game-hud" class="hidden fixed inset-0 z-20 pointer-events-none flex flex-col justify-between p-2.5 sm:p-4">
        <!-- BILAH ATAS HUD -->
        <div class="w-full max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2 pointer-events-auto">
            <div class="glass-panel rounded-2xl px-3 py-2 flex items-center gap-2.5 flex-wrap shadow-xl">
                <button onclick="leaveCurrentRoom()" class="px-2.5 py-2 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 border border-rose-400/40 text-rose-200 text-xs font-extrabold transition">
                    ← Keluar
                </button>
                <button onclick="copyRoomCode()" class="px-4 py-2 rounded-2xl bg-yellow-400 hover:bg-yellow-300 border-2 border-yellow-200 text-slate-950 font-mono shadow-lg shadow-yellow-500/25 transition transform active:scale-95 flex items-center gap-2" title="Klik untuk Salin Kode Kelas">
                    <span class="text-xs sm:text-sm font-black uppercase tracking-wider text-slate-900">KODE:</span>
                    <span id="hud-room-code" class="text-xl sm:text-2xl font-black tracking-[0.22em] text-slate-950 select-all">------</span>
                    <span class="text-base sm:text-lg">📋</span>
                </button>
                <span id="hud-role-badge" class="px-2.5 py-1 rounded-xl bg-indigo-500/20 border border-indigo-400/40 text-indigo-200 text-[11px] font-extrabold">
                    🎒 Layar Pemain
                </span>
                <span id="hud-phase-badge" class="px-2.5 py-1 rounded-xl bg-amber-500/20 border border-amber-400/40 text-amber-200 text-[11px] font-extrabold">
                    ⏳ Ruang Tunggu
                </span>
            </div>

            <div class="glass-panel rounded-2xl px-3.5 py-2 flex items-center gap-2 shadow-xl max-w-full">
                <span class="text-sm">📚</span>
                <span id="hud-subject-info" class="text-xs font-extrabold text-white truncate max-w-[230px] sm:max-w-xs">
                    Fase C • Matematika • Umum
                </span>
                <span id="hud-shield-badge" class="hidden px-2 py-0.5 rounded-lg bg-cyan-500/25 border border-cyan-400/50 text-cyan-200 text-[11px] font-extrabold">
                    🛡️ Perisai Aktif
                </span>
            </div>

            <div class="glass-panel rounded-2xl px-2.5 py-1.5 flex items-center gap-1.5 shadow-xl">
                <button onclick="resetCameraPreset('follow')" class="px-2.5 py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 text-[11px] font-bold transition" title="Kamera Fokus">
                    🎯 Fokus
                </button>
                <button onclick="resetCameraPreset('isometric')" class="px-2.5 py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 text-[11px] font-bold transition" title="Sudut Isometrik">
                    📐 3D
                </button>
                <button onclick="resetCameraPreset('top')" class="px-2.5 py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 text-[11px] font-bold transition" title="Tampak Atas">
                    🗺️ Atas
                </button>
                <button id="hud-music-btn" onclick="toggleMusic()" class="px-2 py-1.5 rounded-xl bg-pink-500/20 hover:bg-pink-500/30 border border-pink-400/40 text-pink-200 text-[11px] font-extrabold transition" title="Musik Latar">
                    🎵
                </button>
                <button id="hud-music-style-btn" onclick="cycleMusicStyle()" class="hidden sm:inline-flex px-2 py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 text-[11px] font-bold transition" title="Ganti Gaya Musik">
                    🎶 Ceria
                </button>
                <button id="hud-sound-btn" onclick="toggleSound()" class="p-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 text-xs font-bold transition" title="Suara">
                    🔊
                </button>
                <button id="hud-fullscreen-btn" onclick="toggleNativeFullscreen()" class="p-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 text-xs font-bold transition" title="Layar Penuh">
                    ⛶
                </button>
            </div>
        </div>

        <!-- PANEL MONITOR REAL-TIME KHUSUS LAYAR GURU -->
        <aside id="teacher-live-monitor" class="hidden pointer-events-auto w-full sm:w-80 max-h-[54dvh] glass-panel-strong rounded-3xl p-3.5 border border-amber-400/30 shadow-2xl flex flex-col gap-2.5 my-auto">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="font-display text-xs font-extrabold uppercase tracking-wider text-amber-300 flex items-center gap-1.5">
                        📡 Monitor Pergerakan Real-Time
                    </h3>
                    <p id="teacher-monitor-subtitle" class="text-[11px] text-slate-300">0 siswa bergabung</p>
                </div>
                <button onclick="openHudDrawer('teacher')" class="px-2.5 py-1 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 text-amber-200 text-[11px] font-extrabold transition">
                    ⚙️ Atur
                </button>
            </div>

            <div id="teacher-ranking-list" class="space-y-1.5 overflow-y-auto max-h-36 pr-1"></div>

            <div class="pt-2 border-t border-slate-800">
                <div class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-1">Log Langkah Siswa</div>
                <div id="teacher-activity-feed" class="space-y-1 max-h-24 overflow-y-auto text-[11px] text-slate-300 pr-1">
                    <div class="text-slate-500 italic">Menunggu aktivitas siswa...</div>
                </div>
            </div>
        </aside>

        <!-- BILAH BAWAH HUD -->
        <div class="w-full max-w-6xl mx-auto pointer-events-auto">
            <!-- A. BILAH KENDALI KHUSUS LAYAR GURU -->
            <div id="teacher-bottom-bar" class="hidden glass-panel-strong rounded-3xl p-3 border border-amber-400/35 shadow-2xl flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2 flex-wrap">
                    <button id="btn-teacher-start-class" onclick="startTeacherClassPhase()" class="px-4 py-2.5 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 text-xs sm:text-sm font-extrabold shadow-lg transition">
                        ▶️ Mulai Kelas
                    </button>
                    <button id="btn-teacher-pause-class" onclick="togglePauseTeacherClassPhase()" class="hidden px-4 py-2.5 rounded-2xl bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs sm:text-sm font-extrabold shadow-lg transition">
                        ⏸️ Jeda
                    </button>
                    <button id="btn-teacher-stop-class" onclick="stopTeacherClassPhase()" class="hidden px-4 py-2.5 rounded-2xl bg-rose-600 hover:bg-rose-500 text-white text-xs sm:text-sm font-extrabold shadow-lg transition">
                        ⏹️ Hentikan
                    </button>
                    <button id="btn-teacher-demo-game" onclick="openTeacherDemoModal()" class="px-3.5 py-2.5 rounded-2xl bg-sky-500/20 hover:bg-sky-500/30 border border-sky-400/40 text-sky-200 text-xs font-extrabold shadow-lg transition">
                        🎮 Demo Permainan
                    </button>
                    <button onclick="openAiStudioModal()" class="px-3.5 py-2.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-extrabold shadow-lg transition">
                        ✨ Soal & AI
                    </button>
                    <button onclick="openHudDrawer('teacher')" class="px-3.5 py-2.5 rounded-2xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-100 text-xs font-extrabold transition">
                        📚 Ubah Mapel & Materi
                    </button>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    <button id="hud-theme-btn" onclick="cycleVisualThemeMode()" class="px-3 py-2.5 rounded-2xl bg-purple-500/20 hover:bg-purple-500/30 border border-purple-400/40 text-purple-200 text-xs font-extrabold transition">
                        🐍 Ular & Tangga
                    </button>
                    <button id="hud-snake-style-btn" onclick="openSnakeCustomizerModal()" class="px-3 py-2.5 rounded-2xl bg-pink-500/20 hover:bg-pink-500/30 border border-pink-400/40 text-pink-200 text-xs font-extrabold transition flex items-center gap-1.5" title="Ganti Warna & Motif Sisik Ular 3D">
                        <span id="hud-snake-swatch" class="w-3 h-3 rounded-full border border-white/80 inline-block" style="background-color:#16a34a"></span>
                        <span>🎨 Warna Ular</span>
                    </button>
                    <button id="hud-board-theme-btn" onclick="openBoardThemeModal()" class="px-3 py-2.5 rounded-2xl bg-amber-600/25 hover:bg-amber-600/35 border border-amber-400/45 text-amber-100 text-xs font-extrabold transition flex items-center gap-1.5" title="Ganti Warna & Nuansa Papan 3D">
                        <span id="hud-board-theme-icon">🌈</span>
                        <span id="hud-board-theme-label">Warna Papan</span>
                    </button>
                    <button id="hud-elev-btn" onclick="cycleBoardElevationStyle()" class="px-3 py-2.5 rounded-2xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 text-amber-200 text-xs font-extrabold transition">
                        🧱 <span class="board-elevation-label">Baris Variatif</span>
                    </button>
                    <button onclick="openChangeTeacherPinModal()" class="px-3 py-2.5 rounded-2xl bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-extrabold transition" title="Edit PIN Layar Guru">
