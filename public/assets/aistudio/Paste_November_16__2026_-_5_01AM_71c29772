        function openQuizForPlayer(room, playerId, isDemo) {
            const pool = (room.questions && room.questions.length > 0) ? room.questions : SEED_QUESTION_BANK;
            if (!studentAskedHistory[playerId]) studentAskedHistory[playerId] = new Set();

            let candidates = pool.filter(q => !studentAskedHistory[playerId].has(q.id));
            let chosen = null;

            if (candidates.length > 0) {
                chosen = candidates[Math.floor(Math.random() * candidates.length)];
                studentAskedHistory[playerId].add(chosen.id);
            } else {
                // Jika seluruh bank soal kelas sudah terjawab, sistem otomatis menghasilkan soal dinamis baru (∞)
                chosen = generateDynamicInfiniteQuestion(room);
            }

            activeQuizData = {
                playerId,
                isDemo,
                question: chosen,
                answered: false,
                isCorrect: false
            };

            const badgeEl = document.getElementById('quiz-modal-badge');
            const stepsEl = document.getElementById('quiz-modal-steps');
            const qEl = document.getElementById('quiz-modal-question');
            const optsEl = document.getElementById('quiz-modal-options');
            const fbEl = document.getElementById('quiz-modal-feedback');
            const contWrap = document.getElementById('quiz-modal-continue-wrap');
            const closeBtn = document.getElementById('quiz-modal-close-btn');

            if (badgeEl) badgeEl.textContent = `${isDemo ? '🎮 DEMO GURU • ' : ''}${room.grade} • ${room.subject}`;
            if (stepsEl) stepsEl.textContent = `Bobot: +${chosen.steps || 3} Langkah`;
            if (qEl) qEl.textContent = chosen.question;
            fbEl?.classList.add('hidden');
            contWrap?.classList.add('hidden');
            closeBtn?.classList.toggle('hidden', !isDemo);

            const letters = ['A', 'B', 'C', 'D'];
            if (optsEl) {
                optsEl.innerHTML = chosen.options.map((opt, idx) => `
                    <button type="button" onclick="selectQuizOption(${idx})"
                        class="quiz-opt-btn w-full p-3.5 rounded-2xl bg-slate-900/90 hover:bg-indigo-500/20 border border-slate-700 hover:border-indigo-400 text-left text-xs sm:text-sm font-bold text-white flex items-center gap-3 transition">
                        <span class="w-7 h-7 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-xs font-extrabold text-indigo-300 shrink-0">${letters[idx]}</span>
                        <span>${opt}</span>
                    </button>
                `).join('');
            }

            document.getElementById('quiz-modal')?.classList.remove('hidden');
        }

        window.selectQuizOption = function (chosenIdx) {
            if (!activeQuizData || activeQuizData.answered) return;
            activeQuizData.answered = true;

            const q = activeQuizData.question;
            const isCorrect = Number(chosenIdx) === Number(q.correctIndex);
            activeQuizData.isCorrect = isCorrect;

            const buttons = document.querySelectorAll('.quiz-opt-btn');
            buttons.forEach((btn, idx) => {
                btn.disabled = true;
                if (idx === Number(q.correctIndex)) {
                    btn.className = 'quiz-opt-btn w-full p-3.5 rounded-2xl bg-emerald-500/25 border-2 border-emerald-400 text-left text-xs sm:text-sm font-extrabold text-emerald-100 flex items-center gap-3';
                } else if (idx === Number(chosenIdx) && !isCorrect) {
                    btn.className = 'quiz-opt-btn w-full p-3.5 rounded-2xl bg-rose-500/25 border-2 border-rose-400 text-left text-xs sm:text-sm font-extrabold text-rose-100 flex items-center gap-3';
                } else {
                    btn.classList.add('opacity-50');
                }
            });

            const fbEl = document.getElementById('quiz-modal-feedback');
            const fbTitle = document.getElementById('quiz-modal-feedback-title');
            const fbExp = document.getElementById('quiz-modal-explanation');
            const contWrap = document.getElementById('quiz-modal-continue-wrap');

            if (fbEl && fbTitle && fbExp) {
                fbEl.classList.remove('hidden');
                if (isCorrect) {
                    playSoundEffect('correct');
