            // Default: 'rainbow' (10 Palet warna edukasi per baris)
            const rowThemes = [
                { a: '#1e3a8a', b: '#1d4ed8', side: 0x172554, border: '#60a5fa' },
                { a: '#065f46', b: '#047857', side: 0x064e3b, border: '#34d399' },
