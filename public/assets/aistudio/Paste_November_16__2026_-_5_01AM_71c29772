        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const styleMap = {
                success: 'bg-emerald-950/95 border-emerald-400/60 text-emerald-100',
                warning: 'bg-amber-950/95 border-amber-400/60 text-amber-100',
                error: 'bg-rose-950/95 border-rose-400/60 text-rose-100',
                info: 'bg-slate-900/95 border-indigo-400/50 text-slate-100'
            };
            const iconMap = {
                success: '✅',
                warning: '⚠️',
                error: '❌',
                info: 'ℹ️'
            };

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto px-4 py-2.5 rounded-2xl border shadow-2xl backdrop-blur-md text-xs font-extrabold flex items-center gap-2 transition-all duration-300 ${styleMap[type] || styleMap.info}`;
            toast.innerHTML = `<span>${iconMap[type] || 'ℹ️'}</span><span>${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-8px)';
                setTimeout(() => toast.remove(), 280);
            }, 3200);
        }

        function playSoundEffect(kind) {
            if (!soundEnabled || typeof Tone === 'undefined') return;
            try {
                if (Tone.context && Tone.context.state !== 'running') {
                    Tone.start();
                }
                duckBackgroundMusicTemporarily();
                const synth = new Tone.Synth({
                    oscillator: { type: 'triangle' },
                    envelope: { attack: 0.01, decay: 0.12, sustain: 0.05, release: 0.2 }
                }).toDestination();
                synth.volume.value = -10;

                if (kind === 'correct') {
                    synth.triggerAttackRelease('C5', '16n');
                    setTimeout(() => synth.triggerAttackRelease('G5', '8n'), 95);
                } else if (kind === 'wrong') {
                    synth.triggerAttackRelease('E3', '8n');
                    setTimeout(() => synth.triggerAttackRelease('C3', '8n'), 120);
                } else if (kind === 'hop') {
                    synth.triggerAttackRelease('E5', '32n');
                } else if (kind === 'ladder') {
                    ['C4', 'E4', 'G4', 'B4', 'C5'].forEach((n, idx) => {
                        setTimeout(() => synth.triggerAttackRelease(n, '16n'), idx * 75);
                    });
                } else if (kind === 'snake') {
                    ['G4', 'E4', 'C4', 'A3'].forEach((n, idx) => {
                        setTimeout(() => synth.triggerAttackRelease(n, '16n'), idx * 85);
                    });
                } else if (kind === 'win') {
                    ['C5', 'E5', 'G5', 'C6'].forEach((n, idx) => {
                        setTimeout(() => synth.triggerAttackRelease(n, '8n'), idx * 110);
                    });
                }
            } catch (_) {}
        }

