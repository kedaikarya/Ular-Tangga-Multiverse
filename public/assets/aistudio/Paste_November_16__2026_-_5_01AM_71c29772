        function renderDrawerContent(room) {
            const players = Object.values(room.players || {}).filter(p => p.role !== 'teacher');
            const pCountEl = document.getElementById('drawer-players-count');
            const pListEl = document.getElementById('drawer-players-list');
            if (pCountEl) pCountEl.textContent = `${players.length} Pemain`;
            if (pListEl) {
                pListEl.innerHTML = players.length === 0
                    ? `<div class="text-xs text-slate-400 italic">Belum ada siswa yang bergabung.</div>`
                    : players.map(p => `
                        <div class="p-3 rounded-2xl bg-slate-900/90 border border-slate-800 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <span class="text-xl">${p.avatar || '🦊'}</span>
                                <div>
                                    <div class="text-xs font-extrabold text-white">${p.name}</div>
                                    <div class="text-[11px] text-slate-400">Petak ${p.position || 1}/100</div>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-xl bg-indigo-500/20 text-indigo-200 text-xs font-extrabold">${p.score || 0}p</span>
                        </div>
                    `).join('');
            }

