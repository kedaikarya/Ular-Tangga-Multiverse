                    room.snakeStyle.colorPreset !== snakeStyleConfig.colorPreset ||
                    room.snakeStyle.customHex !== snakeStyleConfig.customHex ||
                    room.snakeStyle.patternPreset !== snakeStyleConfig.patternPreset;
                if (changed) {
                    snakeStyleConfig = { ...snakeStyleConfig, ...room.snakeStyle };
                    rebuildConnectors3D();
                }
            }
            if (room.elevationStyle && room.elevationStyle !== boardElevationStyle) {
                boardElevationStyle = room.elevationStyle;
                rebuildBoardAndConnectors3D();
