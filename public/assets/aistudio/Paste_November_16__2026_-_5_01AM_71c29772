        function syncAllPawns3D(room) {
            if (!scene || !pawnsGroup) return;
            const players = Object.values(room.players || {}).filter(p => p.role !== 'teacher');
            const activeIds = new Set(players.map(p => p.id));

            Object.keys(pawnMeshes).forEach(pid => {
                if (!activeIds.has(pid)) {
                    pawnsGroup.remove(pawnMeshes[pid]);
                    delete pawnMeshes[pid];
                }
            });

            const tileOccupants = {};
            players.forEach(p => {
                const pos = p.position || 1;
                if (!tileOccupants[pos]) tileOccupants[pos] = [];
                tileOccupants[pos].push(p.id);
            });

            players.forEach(p => {
                let mesh = pawnMeshes[p.id];
                if (!mesh || mesh.userData.avatar !== p.avatar || mesh.userData.name !== p.name) {
                    if (mesh) pawnsGroup.remove(mesh);
                    mesh = createCharacterPawn3D(p);
                    mesh.userData = { avatar: p.avatar, name: p.name };
                    pawnsGroup.add(mesh);
                    pawnMeshes[p.id] = mesh;
                }

                const tileNum = p.position || 1;
                const peers = tileOccupants[tileNum] || [p.id];
                const slotIdx = peers.indexOf(p.id);
                movePawnMeshInstant(p.id, tileNum, false, slotIdx, peers.length);
            });
        }

        function movePawnMeshInstant(playerId, tileNum, hop = false, slotIdx = 0, totalPeers = 1) {
            const mesh = pawnMeshes[playerId];
            if (!mesh) return;
            const { x, z } = getTileGridCoords(tileNum);
            const h = tileHeights[tileNum] || 0.4;

            let offsetX = 0;
            let offsetZ = 0;
            if (totalPeers > 1) {
                const angle = (slotIdx / totalPeers) * Math.PI * 2;
                offsetX = Math.cos(angle) * 0.36;
                offsetZ = Math.sin(angle) * 0.36;
            }

            mesh.position.set(x + offsetX, h + (hop ? 0.35 : 0), z + offsetZ);
            if (hop) {
                setTimeout(() => {
                    if (pawnMeshes[playerId]) {
                        pawnMeshes[playerId].position.y = h;
                    }
                }, 140);
            }
        }

        window.resetCameraPreset = function (preset) {
            cameraPreset = preset;
            if (!camera || !controls) return;
            if (preset === 'top') {
                camera.position.set(0, 27, 0.1);
                controls.target.set(0, 0, 0);
            } else if (preset === 'follow') {
                const room = getCurrentRoom();
                const prof = getActiveUserProfile();
                const me = room?.players?.[prof.id];
                const tile = me?.position || 1;
                const { x, z } = getTileGridCoords(tile);
                const h = tileHeights[tile] || 1;
                camera.position.set(x + 6, h + 8, z + 8);
                controls.target.set(x, h, z);
            } else {
                camera.position.set(14, 18, 17);
                controls.target.set(0, 1.2, 0);
            }
            controls.update();
        };

        function init3DScene() {
            const container = document.getElementById('canvas-container');
            if (!container || typeof THREE === 'undefined') return;

            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x060913);
            scene.fog = new THREE.FogExp2(0x060913, 0.016);

            const w = container.clientWidth || window.innerWidth;
            const h = container.clientHeight || window.innerHeight;
            camera = new THREE.PerspectiveCamera(45, w / h, 0.1, 150);
            camera.position.set(14, 18, 17);

            renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
            renderer.setSize(w, h);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            container.innerHTML = '';
            container.appendChild(renderer.domElement);

            if (typeof THREE.OrbitControls !== 'undefined') {
                controls = new THREE.OrbitControls(camera, renderer.domElement);
                controls.enableDamping = true;
                controls.dampingFactor = 0.07;
                controls.maxPolarAngle = Math.PI * 0.47;
                controls.minDistance = 6;
                controls.maxDistance = 42;
                controls.target.set(0, 1.2, 0);
                controls.update();
            }

            const ambientLight = new THREE.AmbientLight(0xc7d2fe, 0.72);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.95);
            dirLight.position.set(14, 26, 16);
            dirLight.castShadow = true;
            dirLight.shadow.mapSize.width = 1024;
            dirLight.shadow.mapSize.height = 1024;
            scene.add(dirLight);

            const rimLight = new THREE.PointLight(0x818cf8, 0.65, 50);
            rimLight.position.set(-14, 12, -14);
            scene.add(rimLight);

            basePlatformMesh = new THREE.Mesh(
                new THREE.BoxGeometry(TILE_SIZE * 10.6, 0.4, TILE_SIZE * 10.6),
                new THREE.MeshStandardMaterial({ color: 0x0b1120, roughness: 0.7, metalness: 0.3 })
            );
            basePlatformMesh.position.y = -0.2;
            basePlatformMesh.receiveShadow = true;
            scene.add(basePlatformMesh);

            pawnsGroup = new THREE.Group();
            scene.add(pawnsGroup);

            rebuildBoardAndConnectors3D();

            window.addEventListener('resize', () => {
                if (!renderer || !camera) return;
                const nw = container.clientWidth || window.innerWidth;
                const nh = container.clientHeight || window.innerHeight;
                camera.aspect = nw / nh;
                camera.updateProjectionMatrix();
                renderer.setSize(nw, nh);
            });
        }

        function animate3DLoop() {
            requestAnimationFrame(animate3DLoop);
            const t = performance.now() * 0.002;

            animatedLifts.forEach(item => {
                const progress = (Math.sin(t + item.phase) + 1) * 0.5;
                item.cabin.position.lerpVectors(item.p1, item.p2, progress);
            });

            animatedTongues.forEach(item => {
                const s = 0.85 + Math.sin(t * 4 + item.phase) * 0.25;
                item.tongue.scale.z = s;
            });

            if (controls) controls.update();
            if (renderer && scene && camera) {
                renderer.render(scene, camera);
            }
        }

        // =========================================================================
        // 15. SINKRONISASI MULTI-TAB REAL-TIME & INISIALISASI WINDOW.ONLOAD
        // =========================================================================
        if (broadcastChannel) {
            broadcastChannel.onmessage = (ev) => {
                const data = ev.data;
                if (!data) return;
                if (data.type === 'TEACHER_PIN_UPDATED' && data.pin) {
                    try {
                        localStorage.setItem(STORAGE_KEYS.TEACHER_PIN, data.pin);
                    } catch (_) {}
                } else if (data.type === 'ROOM_UPDATED' && data.room) {
                    const mapObj = getLocalRoomsMap();
                    mapObj[data.room.code] = data.room;
                    saveLocalRoomsMap(mapObj);
                    renderOpenRoomsList();
                    if (currentRoomId === data.room.code) {
                        if (activeHudDrawerTab !== 'chat') {
                            unreadChatCount += 1;
                            document.getElementById('btn-player-chat-badge')?.classList.remove('hidden');
                        }
                        syncRoomToUIAnd3D(data.room);
                    }
                } else if (data.type === 'ROOM_DELETED' && data.code) {
                    const mapObj = getLocalRoomsMap();
                    delete mapObj[data.code];
                    saveLocalRoomsMap(mapObj);
                    renderOpenRoomsList();
                    if (currentRoomId === data.code) {
                        showToast('Kelas telah ditutup oleh Guru.', 'warning');
                        window.leaveCurrentRoom();
                    }
                }
            };
        }

        window.addEventListener('storage', (ev) => {
            if (ev.key === STORAGE_KEYS.ROOMS) {
                renderOpenRoomsList();
                const room = getCurrentRoom();
                if (room) syncRoomToUIAnd3D(room);
            }
        });

        window.onload = function () {
            getActiveUserProfile();
            loadMusicPreferences();
            setupFirstGestureMusicAutoStart();
            updateLobbyProfileUI();
            updateTeacherAuthUI();
            renderOpenRoomsList();
            init3DScene();
            animate3DLoop();
        };
    </script>
