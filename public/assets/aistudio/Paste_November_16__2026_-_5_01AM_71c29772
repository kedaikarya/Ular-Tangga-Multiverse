        window.closeQuizModalAndMove = function () {
            document.getElementById('quiz-modal')?.classList.add('hidden');
            if (!activeQuizData) return;

            const { playerId, isDemo, question, isCorrect } = activeQuizData;
            activeQuizData = null;

            const room = getCurrentRoom();
            if (!room || !room.players?.[playerId]) return;

            const player = room.players[playerId];
            player.answeredCount = (player.answeredCount || 0) + 1;

            if (!isDemo) {
                const prof = getActiveUserProfile();
                prof.totalAnswered = (prof.totalAnswered || 0) + 1;
                if (!prof.subjectStats) prof.subjectStats = {};
                const subj = room.subject || 'Umum';
                if (!prof.subjectStats[subj]) prof.subjectStats[subj] = { answered: 0, correct: 0 };
                prof.subjectStats[subj].answered += 1;

                if (isCorrect) {
                    prof.totalCorrect = (prof.totalCorrect || 0) + 1;
                    prof.subjectStats[subj].correct += 1;
                    consecutiveCorrectCount += 1;
                    if (consecutiveCorrectCount >= 3 && !hasStreakShield) {
                        hasStreakShield = true;
                        showToast('🛡️ 3 Benar Beruntun! Perisai Ilmu aktif melindungi dari ular!', 'success');
                    }
                } else {
                    consecutiveCorrectCount = 0;
                }
                saveUserProfile(prof);
                updateGlobalLeaderboard(prof);
            }

            if (!isCorrect) {
                appendActivityLog(room, `${player.avatar} ${player.name} menjawab kurang tepat`);
                persistRoomUpdate(room, 'ROOM_UPDATED');
                return;
            }

            const steps = Number(question.steps) || 3;
            player.correctCount = (player.correctCount || 0) + 1;
            player.score = (player.score || 0) + steps * 25;

            if (!isDemo) {
                const prof = getActiveUserProfile();
                prof.totalScore = (prof.totalScore || 0) + steps * 25;
                saveUserProfile(prof);
                updateGlobalLeaderboard(prof);
            }

            executePawnBoardMovement(room, playerId, steps, isDemo);
        };

        function executePawnBoardMovement(room, playerId, steps, isDemo = false) {
            const player = room.players?.[playerId];
            if (!player) return;

            isAnimatingMove = true;
            syncRoomToUIAnd3D(room);

            let currentPos = player.position || 1;
            const targetPos = Math.min(100, currentPos + steps);
            let stepCursor = currentPos;

            const hopTimer = setInterval(() => {
                if (stepCursor < targetPos) {
                    stepCursor += 1;
                    player.position = stepCursor;
                    playSoundEffect('hop');
                    movePawnMeshInstant(playerId, stepCursor, true);
                } else {
                    clearInterval(hopTimer);

                    // Cek Tangga / Lift atau Ular / Perosotan
                    if (LADDERS[stepCursor]) {
                        const dest = LADDERS[stepCursor];
                        player.position = dest;
                        player.score = (player.score || 0) + 50;
                        playSoundEffect('ladder');
                        const label = visualThemeMode === 'modern' ? 'naik Sky-Lift' : 'naik Tangga';
                        appendActivityLog(room, `🪜 ${player.avatar} ${player.name} ${label} (${stepCursor} → ${dest})!`);
                        if (!isDemo) showToast(`🪜 Hebat! Naik ke petak ${dest}! (+50 Poin)`, 'success');
                    } else if (SNAKES[stepCursor]) {
                        if (!isDemo && hasStreakShield) {
                            hasStreakShield = false;
                            consecutiveCorrectCount = 0;
                            appendActivityLog(room, `🛡️ ${player.avatar} ${player.name} menahan ular di petak ${stepCursor} dengan Perisai Ilmu!`);
                            showToast(`🛡️ Perisai Ilmu melindungimu dari ular di petak ${stepCursor}!`, 'success');
                        } else {
                            const dest = SNAKES[stepCursor];
                            player.position = dest;
                            playSoundEffect('snake');
                            const label = visualThemeMode === 'modern' ? 'meluncur Perosotan' : 'turun Ular';
                            appendActivityLog(room, `🐍 ${player.avatar} ${player.name} ${label} (${stepCursor} → ${dest})`);
                            if (!isDemo) showToast(`🐍 Ups! Turun ke petak ${dest}. Tetap semangat!`, 'warning');
                        }
                    } else {
                        appendActivityLog(room, `${player.avatar} ${player.name} maju ke petak ${stepCursor}`);
                    }

                    isAnimatingMove = false;

                    if (player.position >= 100) {
                        player.position = 100;
                        player.score = (player.score || 0) + 200;
                        if (!isDemo) {
                            const prof = getActiveUserProfile();
                            prof.gamesWon = (prof.gamesWon || 0) + 1;
                            prof.totalScore = (prof.totalScore || 0) + 200;
                            saveUserProfile(prof);
                            updateGlobalLeaderboard(prof);
                        }
                        appendActivityLog(room, `🏆 ${player.avatar} ${player.name} mencapai Puncak Petak 100!`);
                        if (!isDemo) {
                            room.phase = 'finished';
                            persistRoomUpdate(room, 'ROOM_UPDATED');
                            showWinnerPodiumModal(room);
                            return;
                        }
                    }

                    persistRoomUpdate(room, 'ROOM_UPDATED');
                }
            }, 220);
        }

