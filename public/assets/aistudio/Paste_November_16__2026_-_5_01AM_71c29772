        window.copyRoomCode = function () {
            const code = currentRoomId || '';
            if (!code) return;
            try {
                const ta = document.createElement('textarea');
                ta.value = code;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                ta.remove();
                showToast(`Kode kelas "${code}" disalin ke clipboard!`, 'success');
